From b4b39920fc109a9debbe98e5ca888c659f961302 Mon Sep 17 00:00:00 2001
From: CaetanoMrsc <c.marasca@edu.pucrs.br>
Date: Tue, 10 Nov 2026 20:18:44 -0300
Subject: [PATCH] Tutorial 3.1 - Adiciona a politica de escalonamento
 SCHED_LOW_IDLE

Nova politica (valor 7) com prioridade menor que SCHED_IDLE:
- peso WEIGHT_LOW_IDLEPRIO = 1 (SCHED_IDLE usa 3);
- tarefas SCHED_LOW_IDLE nao preemptam tarefas SCHED_IDLE e sao
  preemptadas por qualquer outra politica;
- prioridade max/min = 0, como SCHED_IDLE.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 include/uapi/linux/sched.h |  1 +
 kernel/sched/core.c        | 16 ++++++++++++++--
 kernel/sched/fair.c        | 17 +++++++++++++----
 kernel/sched/sched.h       | 10 +++++++++-
 4 files changed, 37 insertions(+), 7 deletions(-)

diff --git a/include/uapi/linux/sched.h b/include/uapi/linux/sched.h
index e2a6c7b3..b14439e0 100644
--- a/include/uapi/linux/sched.h
+++ b/include/uapi/linux/sched.h
@@ -39,6 +39,7 @@
 /* SCHED_ISO: reserved but not implemented yet */
 #define SCHED_IDLE		5
 #define SCHED_DEADLINE		6
+#define SCHED_LOW_IDLE		7
 
 /* Can be ORed in to make sure the process is reverted back to SCHED_NORMAL on fork */
 #define SCHED_RESET_ON_FORK     0x40000000
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 99326c37..22121517 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -738,6 +738,15 @@ static void set_load_weight(struct task_struct *p)
 	int prio = p->static_prio - MAX_RT_PRIO;
 	struct load_weight *load = &p->se.load;
 
+	/*
+	 * SCHED_LOW_IDLE tasks get the lowest weight of all:
+	 */
+	if (idle_low_policy(p->policy)) {
+		load->weight = scale_load(WEIGHT_LOW_IDLEPRIO);
+		load->inv_weight = WMULT_LOW_IDLEPRIO;
+		return;
+	}
+
 	/*
 	 * SCHED_IDLE tasks get minimal weight:
 	 */
@@ -4047,10 +4056,11 @@ static int __sched_setscheduler(struct task_struct *p,
 			return -EPERM;
 
 		/*
-		 * Treat SCHED_IDLE as nice 20. Only allow a switch to
+		 * Treat SCHED_IDLE and SCHED_LOW_IDLE as nice 20. Only allow a switch to
 		 * SCHED_NORMAL if the RLIMIT_NICE would normally permit it.
 		 */
-		if (idle_policy(p->policy) && !idle_policy(policy)) {
+		if ((idle_policy(p->policy) || idle_low_policy(p->policy)) &&
+		    !idle_policy(policy) && !idle_low_policy(policy)) {
 			if (!can_nice(p, task_nice(p)))
 				return -EPERM;
 		}
@@ -5021,6 +5031,7 @@ SYSCALL_DEFINE1(sched_get_priority_max, int, policy)
 	case SCHED_NORMAL:
 	case SCHED_BATCH:
 	case SCHED_IDLE:
+	case SCHED_LOW_IDLE:
 		ret = 0;
 		break;
 	}
@@ -5048,6 +5059,7 @@ SYSCALL_DEFINE1(sched_get_priority_min, int, policy)
 	case SCHED_NORMAL:
 	case SCHED_BATCH:
 	case SCHED_IDLE:
+	case SCHED_LOW_IDLE:
 		ret = 0;
 	}
 	return ret;
diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index c95880e2..55f5730f 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -6064,7 +6064,9 @@ wakeup_preempt_entity(struct sched_entity *curr, struct sched_entity *se)
 
 static void set_last_buddy(struct sched_entity *se)
 {
-	if (entity_is_task(se) && unlikely(task_of(se)->policy == SCHED_IDLE))
+	if (entity_is_task(se) &&
+	    unlikely(task_of(se)->policy == SCHED_IDLE ||
+		     task_of(se)->policy == SCHED_LOW_IDLE))
 		return;
 
 	for_each_sched_entity(se) {
@@ -6076,7 +6078,9 @@ static void set_last_buddy(struct sched_entity *se)
 
 static void set_next_buddy(struct sched_entity *se)
 {
-	if (entity_is_task(se) && unlikely(task_of(se)->policy == SCHED_IDLE))
+	if (entity_is_task(se) &&
+	    unlikely(task_of(se)->policy == SCHED_IDLE ||
+		     task_of(se)->policy == SCHED_LOW_IDLE))
 		return;
 
 	for_each_sched_entity(se) {
@@ -6135,7 +6139,12 @@ static void check_preempt_wakeup(struct rq *rq, struct task_struct *p, int wake_
 
 	/* Idle tasks are by definition preempted by non-idle tasks. */
 	if (unlikely(curr->policy == SCHED_IDLE) &&
-	    likely(p->policy != SCHED_IDLE))
+	    likely(p->policy != SCHED_IDLE && p->policy != SCHED_LOW_IDLE))
+		goto preempt;
+
+	/* Low idle tasks are preempted by any task that is not low idle. */
+	if (unlikely(curr->policy == SCHED_LOW_IDLE) &&
+	    likely(p->policy != SCHED_LOW_IDLE))
 		goto preempt;
 
 	/*
@@ -6534,7 +6543,7 @@ static int task_hot(struct task_struct *p, struct lb_env *env)
 	if (p->sched_class != &fair_sched_class)
 		return 0;
 
-	if (unlikely(p->policy == SCHED_IDLE))
+	if (unlikely(p->policy == SCHED_IDLE || p->policy == SCHED_LOW_IDLE))
 		return 0;
 
 	/*
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index eeef1a30..8738fd7f 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -125,6 +125,10 @@ static inline int idle_policy(int policy)
 {
 	return policy == SCHED_IDLE;
 }
+static inline int idle_low_policy(int policy)
+{
+	return policy == SCHED_LOW_IDLE;
+}
 static inline int fair_policy(int policy)
 {
 	return policy == SCHED_NORMAL || policy == SCHED_BATCH;
@@ -141,7 +145,8 @@ static inline int dl_policy(int policy)
 }
 static inline bool valid_policy(int policy)
 {
-	return idle_policy(policy) || fair_policy(policy) ||
+	return idle_policy(policy) || idle_low_policy(policy) ||
+		fair_policy(policy) ||
 		rt_policy(policy) || dl_policy(policy);
 }
 
@@ -1353,6 +1358,9 @@ static inline void finish_lock_switch(struct rq *rq, struct task_struct *prev)
 #define WEIGHT_IDLEPRIO                3
 #define WMULT_IDLEPRIO         1431655765
 
+#define WEIGHT_LOW_IDLEPRIO            1
+#define WMULT_LOW_IDLEPRIO     1431655765
+
 extern const int sched_prio_to_weight[40];
 extern const u32 sched_prio_to_wmult[40];
 
-- 
